# Dockerfile for Quantum ESPRESSO Web UI Backend
FROM ubuntu:22.04

# Set non-interactive mode for apt
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    libopenmpi-dev \
    openmpi-bin \
    libfftw3-dev \
    libfftw3-3 \
    liblapack-dev \
    liblapack3 \
    libblas-dev \
    libblas3 \
    libopenblas-dev \
    libopenblas0 \
    libgomp1 \
    gfortran \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy pre-built QE binaries from the build directory
RUN mkdir -p /opt/qe/bin
COPY build/bin/pw.x /opt/qe/bin/
COPY build/bin/pp.x /opt/qe/bin/
RUN chmod +x /opt/qe/bin/*

# Set up pseudopotentials directory
RUN mkdir -p /opt/qe/pseudo

# Copy existing pseudopotentials from the project
COPY pseudo/*.UPF /opt/qe/pseudo/
COPY pseudo/*.upf /opt/qe/pseudo/

# Go back to app directory
WORKDIR /app

# Copy backend application
COPY web-ui/backend/ /app/

# Create virtual environment and install Python dependencies
RUN python3 -m venv venv && \
    . venv/bin/activate && \
    pip install --upgrade pip && \
    pip install -r requirements.txt

# Create directories for simulations
RUN mkdir -p /app/simulations /app/logs

# Environment variables
ENV QE_BIN_PATH=/opt/qe/bin
ENV QE_PSEUDO_PATH=/opt/qe/pseudo
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8000

# Run the application
CMD ["/app/venv/bin/python", "run.py"]