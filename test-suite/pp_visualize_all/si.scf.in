 &control
    calculation = 'scf'
    prefix = 'si'
    outdir = './out'
    pseudo_dir = '../../pseudo/'
    tprnfor = .true.
    tstress = .true.
 /
 &system
    ibrav=  2, celldm(1) =10.20, nat=  2, ntyp= 1,
    ecutwfc = 18.0
 /
 &electrons
    diagonalization='david'
    mixing_beta = 0.7
    conv_thr =  1.0d-8
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS automatic
  4 4 4  0 0 0