&control
    calculation = 'scf'
    pseudo_dir = 'pseudo/'
    outdir='./out/'
    prefix='si_isolated'
/
&system
    ibrav = 1, 
    celldm(1) = 30.0,  ! Large cell
    nat = 2, 
    ntyp = 1,
    ecutwfc = 30.0
/
&electrons
    conv_thr = 1.0d-8
/
&AUTO_OPTIMIZE
  optimize_kpoints = .false.
  optimize_cutoff = .false.
/
ATOMIC_SPECIES
 Si  28.086  Si_r.upf
ATOMIC_POSITIONS (bohr)
 Si  0.0  0.0  0.0
 Si 25.0 25.0 25.0  ! Very far from the first atom
K_POINTS gamma