&CONTROL
  calculation = 'scf'
  prefix = 'si'
  pseudo_dir = 'pseudo/'
  outdir = './'
/
&SYSTEM
  ibrav = 2
  celldm(1) = 10.26
  nat = 2
  ntyp = 1
  ecutwfc = 30.0
/
&ELECTRONS
  conv_thr = 1.0d-8
/
&AUTO_OPTIMIZE
  optimize_kpoints = .true.
  optimize_cutoff = .true.
  kpoint_spacing = 0.15
/
ATOMIC_SPECIES
  Si 28.086 Si.bhs
ATOMIC_POSITIONS (alat)
  Si 0.00 0.00 0.00
  Si 0.25 0.25 0.25
