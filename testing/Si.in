  GNU nano 4.8                                                      tests/test_checkpoint.in                                                                &CONTROL
    calculation = 'scf'
    prefix = 'test'
    pseudo_dir = 'pseudo/'
    outdir = '.'
  /
  &SYSTEM
    ibrav = 2
    celldm(1) = 10.2
    nat = 3
    ntyp = 1
    ecutwfc = 60.0
  /
  &ELECTRONS
    mixing_beta = 0.7
    conv_thr = 1.0d-8
  /
  &AUTO_OPTIMIZE
  optimize_kpoints = .true.
  optimize_cutoff = .true.
  kpoint_spacing = 0.15
  /
  ATOMIC_SPECIES
   Si 28.086 Si.bhs
  ATOMIC_POSITIONS (alat)
   Si 0.0 0.0 0.0
   Si 0.25 0.25 0.25
   Si 0.5 0.5 0.5
  K_POINTS (automatic)
   8 8 8 1 1 1