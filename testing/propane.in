&CONTROL
    calculation = 'scf'
    prefix = 'propane'
    pseudo_dir = './pseudo/'
    outdir = './out/'
/
&SYSTEM
    ibrav = 0
    nat = 5
    ntyp = 2
    ecutwfc = 20.0
    ecutrho = 400.0
    input_dft = 'pbe0'
    nqx1 = 4, nqx2 = 4, nqx3 = 4
/
&ELECTRONS
    mixing_beta = 0.7
    conv_thr = 1.0d-8
    diagonalization = 'david'
/
ATOMIC_SPECIES
 C  12.011  C-q4.gth
 H   1.008  H-q1.gth
ATOMIC_POSITIONS (angstrom)
 C   0.000000   0.000000   0.000000
 H  -0.514000   0.891000   0.000000
 H  -0.514000  -0.891000   0.000000
 H   2.054000   0.891000   0.000000
 H   1.540000   0.000000   0.000000
CELL_PARAMETERS (angstrom)
  10.0  0.0  0.0
   0.0 10.0  0.0
   0.0  0.0 10.0
K_POINTS gamma